<Window x:Class="LuoIsHere.CodexMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Text.SettingsTitle}"
        Icon="Assets/CodexMonitor.ico"
        Width="460"
        Height="610"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="{StaticResource PrimaryTextBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        KeyDown="OnWindowKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38"
                        CornerRadius="0"
                        GlassFrameThickness="-1"
                        ResizeBorderThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="HelpFocusStyle" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="{StaticResource PrimaryTextBrush}" BorderThickness="1" CornerRadius="4" Margin="1" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HelpToolTipStyle" TargetType="ToolTip">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="MaxWidth" Value="300" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="#F2181818" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HelpIconStyle" TargetType="Button">
      <Setter Property="Content" Value="ⓘ" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource HelpFocusStyle}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
      <Setter Property="AutomationProperties.ItemType" Value="{DynamicResource Text.HelpLabel}" />
      <!-- Hover and keyboard handlers own the lifetime; do not let ToolTipService race them. -->
      <Setter Property="ToolTipService.IsEnabled" Value="False" />
      <EventSetter Event="MouseEnter" Handler="OnHelpMouseEnter" />
      <EventSetter Event="MouseLeave" Handler="OnHelpMouseLeave" />
      <EventSetter Event="PreviewKeyDown" Handler="OnHelpPreviewKeyDown" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnHelpLostKeyboardFocus" />
      <EventSetter Event="Unloaded" Handler="OnHelpUnloaded" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="#24FFFFFF" />
      <Setter Property="BorderBrush" Value="#32FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="HeaderSurface"
                    Margin="0,0,5,0"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter TargetName="HeaderSurface"
                        Property="Background"
                        Value="#2FFFFFFF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderSurface"
                        Property="Background"
                        Value="#20FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="WindowSurface"
          Background="{StaticResource WindowTintBrush}"
          BorderBrush="#32FFFFFF"
          BorderThickness="1"
          CornerRadius="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="TitleBarSurface"
              Grid.Row="0"
              Background="#18FFFFFF"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="0">
        <Grid Margin="12,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Width="16"
                 Height="16"
                 VerticalAlignment="Center"
                 Source="Assets/CodexMonitor.ico" />
          <TextBlock Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Text="{DynamicResource Text.Settings}" />
          <Button Grid.Column="2"
                  Click="OnCloseClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource TitleBarButtonStyle}"
                  ToolTip="{DynamicResource Text.Close}">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       Text="&#xE8BB;" />
          </Button>
        </Grid>
      </Border>

      <TabControl Grid.Row="1"
                  Margin="18,12,18,8"
                  Background="Transparent"
                  BorderThickness="0">
        <TabItem Header="{DynamicResource Text.General}">
          <ScrollViewer Margin="6,13,6,0"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                           FontWeight="SemiBold" Text="{DynamicResource Text.Language}" />
                <Button x:Name="LanguageHelp" Style="{StaticResource HelpIconStyle}"
                        AutomationProperties.Name="{DynamicResource Text.Language}"
                        Tag="{DynamicResource Text.LanguageHint}">
                  <Button.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}"
                             Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                  </Button.ToolTip>
                </Button>
              </StackPanel>
              <ComboBox Margin="0,8,0,4" Padding="6,3" HorizontalAlignment="Left" MinWidth="200"
                        ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                        SelectedValue="{Binding Language}" />
              <Border Height="1" Margin="0,14,0,14" Background="{StaticResource DividerBrush}" />
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11" FontWeight="SemiBold" Text="{DynamicResource Text.Startup}" />
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{DynamicResource Text.StartupEnabled}" IsChecked="{Binding StartupEnabled}" />
                <Button Grid.Column="1" x:Name="StartupHelp" Style="{StaticResource HelpIconStyle}"
                        AutomationProperties.Name="{DynamicResource Text.StartupEnabled}"
                        Tag="{DynamicResource Text.StartupHint}">
                  <Button.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}"
                             Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                  </Button.ToolTip>
                </Button>
              </Grid>
              <Grid HorizontalAlignment="Left" Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{DynamicResource Text.MinimizeToTray}"
                          Margin="0,4,0,4"
                          IsEnabled="{Binding StartupEnabled}"
                          IsChecked="{Binding MinimizeToTray}" />
                <Button Grid.Column="1" x:Name="MinimizeHelp" Style="{StaticResource HelpIconStyle}"
                        AutomationProperties.Name="{DynamicResource Text.MinimizeToTray}"
                        Tag="{DynamicResource Text.StartupWindowHint}">
                  <Button.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}"
                             Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                  </Button.ToolTip>
                </Button>
              </Grid>
              <TextBlock Margin="0,6,0,0" FontSize="10" Text="{Binding StartupStatus}" TextWrapping="Wrap" />
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"
                         Text="{Binding WindowsControlNotice}" TextWrapping="Wrap" />
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{DynamicResource Text.RegisterCurrentPath}" FontSize="11"
                          IsEnabled="{Binding StartupEnabled}" IsChecked="{Binding RegisterCurrentPath}" />
                <Button Grid.Column="1" x:Name="RegisterHelp" Style="{StaticResource HelpIconStyle}"
                        AutomationProperties.Name="{DynamicResource Text.RegisterCurrentPath}"
                        Tag="{DynamicResource Text.RegisterCurrentPathHelp}">
                  <Button.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}"
                             Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                  </Button.ToolTip>
                </Button>
              </Grid>
              <Border Height="1" Margin="0,8,0,14" Background="{StaticResource DividerBrush}" />
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="{DynamicResource Text.Notifications}" />
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{DynamicResource Text.NotificationsEnabled}"
                          IsChecked="{Binding NotificationsEnabled}" />
                <Button Grid.Column="1" x:Name="NotificationsHelp" Style="{StaticResource HelpIconStyle}"
                        AutomationProperties.Name="{DynamicResource Text.NotificationsEnabled}"
                        Tag="{DynamicResource Text.NotificationsHelp}">
                  <Button.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}"
                             Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                  </Button.ToolTip>
                </Button>
              </Grid>

              <Border Height="1"
                      Margin="0,8,0,14"
                      Background="{StaticResource DividerBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Text="{DynamicResource Text.RefreshInterval}" />
                  <Button x:Name="RefreshIntervalHelp" Style="{StaticResource HelpIconStyle}"
                          AutomationProperties.Name="{DynamicResource Text.RefreshInterval}"
                          Tag="{DynamicResource Text.RefreshIntervalHint}">
                    <Button.ToolTip>
                      <ToolTip Style="{StaticResource HelpToolTipStyle}"
                               Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                    </Button.ToolTip>
                  </Button>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding RefreshIntervalText}" />
              </Grid>
              <Slider Margin="0,8,0,0"
                      Minimum="1"
                      Maximum="60"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      Value="{Binding RefreshIntervalMinutes}" />

              <Border Height="1"
                      Margin="0,15,0,14"
                      Background="{StaticResource DividerBrush}" />

              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="{DynamicResource Text.MainDisplay}" />
              <CheckBox Content="{DynamicResource Text.ShowFiveHour}"
                        IsChecked="{Binding ShowFiveHourQuota}" />
              <CheckBox Content="{DynamicResource Text.ShowWeekly}"
                        IsChecked="{Binding ShowWeeklyQuota}" />
              <CheckBox Content="{DynamicResource Text.ShowReset}"
                        IsChecked="{Binding ShowResetTimes}" />
              <CheckBox Content="{DynamicResource Text.ShowSubscription}"
                        IsChecked="{Binding ShowSubscription}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource Text.FloatingWindow}">
          <ScrollViewer Margin="6,13,6,0"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="{DynamicResource Text.State}" />
              <CheckBox Content="{DynamicResource Text.EnableFloating}"
                        IsChecked="{Binding FloatingWindowEnabled}" />
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{DynamicResource Text.LockFloatingHint}"
                          IsChecked="{Binding FloatingWindowLocked}" />
                <Button Grid.Column="1" x:Name="FloatingLockHelp" Style="{StaticResource HelpIconStyle}"
                        AutomationProperties.Name="{DynamicResource Text.LockFloatingHint}"
                        Tag="{DynamicResource Text.DragHint}">
                  <Button.ToolTip>
                    <ToolTip Style="{StaticResource HelpToolTipStyle}"
                             Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                  </Button.ToolTip>
                </Button>
              </Grid>

              <Border Height="1"
                      Margin="0,15,0,14"
                      Background="{StaticResource DividerBrush}" />

              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="{DynamicResource Text.FloatingDisplay}" />
              <CheckBox Content="{DynamicResource Text.ShowFiveHour}"
                        IsChecked="{Binding FloatingShowFiveHourQuota}" />
              <CheckBox Content="{DynamicResource Text.ShowWeekly}"
                        IsChecked="{Binding FloatingShowWeeklyQuota}" />
              <CheckBox Content="{DynamicResource Text.ShowUpdated}"
                        IsChecked="{Binding FloatingShowLastRefreshTime}" />
              <CheckBox Content="{DynamicResource Text.ShowReset}"
                        IsChecked="{Binding FloatingShowResetTimes}" />
              <CheckBox Content="{DynamicResource Text.ShowSubscription}"
                        IsChecked="{Binding FloatingShowSubscription}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border Grid.Row="2"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel Margin="16,0">
          <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
            <TextBlock Foreground="#FFFFB070" FontSize="11" TextWrapping="Wrap" Text="{Binding SaveError}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Margin" Value="0,10,0,0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SaveError}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </ScrollViewer>
        <StackPanel Height="52"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Button Click="OnCancelClick"
                  Content="{DynamicResource Text.Cancel}"
                  IsCancel="True"
                  Style="{StaticResource SettingsButtonStyle}" />
          <Button Click="OnSaveClick"
                  Content="{DynamicResource Text.Save}"
                  IsDefault="True"
                  Background="#FF1769E0"
                  BorderBrush="#FF2B7DE9"
                  Style="{StaticResource SettingsButtonStyle}" />
        </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
