<Window x:Class="LuoIsHere.CodexMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CodexMonitor 设置"
        Icon="Assets/CodexMonitor.ico"
        Width="420"
        Height="490"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource PrimaryTextBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        KeyDown="OnWindowKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SettingsButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="#24FFFFFF" />
      <Setter Property="BorderBrush" Value="#32FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="HeaderSurface"
                    Margin="0,0,5,0"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter TargetName="HeaderSurface"
                        Property="Background"
                        Value="#2FFFFFFF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderSurface"
                        Property="Background"
                        Value="#20FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#F2181818"
          BorderBrush="#32FFFFFF"
          BorderThickness="1"
          CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
        <RowDefinition Height="52" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="#18FFFFFF"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="12,12,0,0">
        <Grid Margin="12,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Width="16"
                 Height="16"
                 VerticalAlignment="Center"
                 Source="Assets/CodexMonitor.ico" />
          <TextBlock Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Text="设置" />
          <Button Grid.Column="2"
                  Click="OnCloseClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource TitleBarButtonStyle}"
                  ToolTip="关闭">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       Text="&#xE8BB;" />
          </Button>
        </Grid>
      </Border>

      <TabControl Grid.Row="1"
                  Margin="18,12,18,8"
                  Background="Transparent"
                  BorderThickness="0">
        <TabItem Header="常规">
          <ScrollViewer Margin="6,13,6,0"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="通知" />
              <CheckBox Content="启用系统通知"
                        IsChecked="{Binding NotificationsEnabled}" />

              <Border Height="1"
                      Margin="0,8,0,14"
                      Background="{StaticResource DividerBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="自动刷新间隔" />
                <TextBlock Grid.Column="1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding RefreshIntervalMinutes, StringFormat={}{0} 分钟}" />
              </Grid>
              <Slider Margin="0,8,0,0"
                      Minimum="1"
                      Maximum="60"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      Value="{Binding RefreshIntervalMinutes}" />
              <TextBlock Margin="0,4,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="10"
                         Text="保存后从当前时刻重新计算下一次自动刷新。" />

              <Border Height="1"
                      Margin="0,15,0,14"
                      Background="{StaticResource DividerBrush}" />

              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="主窗口显示内容" />
              <CheckBox Content="显示 5H 余量"
                        IsChecked="{Binding ShowFiveHourQuota}" />
              <CheckBox Content="显示 7D 余量"
                        IsChecked="{Binding ShowWeeklyQuota}" />
              <CheckBox Content="显示额度重置时间"
                        IsChecked="{Binding ShowResetTimes}" />
              <CheckBox Content="显示订阅类型"
                        IsChecked="{Binding ShowSubscription}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="悬浮窗">
          <ScrollViewer Margin="6,13,6,0"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="状态" />
              <CheckBox Content="启用悬浮窗"
                        IsChecked="{Binding FloatingWindowEnabled}" />
              <CheckBox Content="锁定悬浮窗（鼠标点击穿透并保持置顶）"
                        IsChecked="{Binding FloatingWindowLocked}" />
              <TextBlock Margin="0,2,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="10"
                         Text="解锁时按住悬浮窗空白区域即可拖动。锁定后可从托盘菜单解锁。"
                         TextWrapping="Wrap" />

              <Border Height="1"
                      Margin="0,15,0,14"
                      Background="{StaticResource DividerBrush}" />

              <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="悬浮窗显示内容" />
              <CheckBox Content="显示 5H 余量"
                        IsChecked="{Binding FloatingShowFiveHourQuota}" />
              <CheckBox Content="显示 7D 余量"
                        IsChecked="{Binding FloatingShowWeeklyQuota}" />
              <CheckBox Content="显示最近成功更新时间"
                        IsChecked="{Binding FloatingShowLastRefreshTime}" />
              <CheckBox Content="显示额度重置时间"
                        IsChecked="{Binding FloatingShowResetTimes}" />
              <CheckBox Content="显示订阅类型"
                        IsChecked="{Binding FloatingShowSubscription}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border Grid.Row="2"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <StackPanel Margin="16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Button Click="OnCancelClick"
                  Content="取消"
                  IsCancel="True"
                  Style="{StaticResource SettingsButtonStyle}" />
          <Button Click="OnSaveClick"
                  Content="保存"
                  IsDefault="True"
                  Background="#FF1769E0"
                  BorderBrush="#FF2B7DE9"
                  Style="{StaticResource SettingsButtonStyle}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
