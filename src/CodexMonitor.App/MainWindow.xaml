<Window x:Class="LuoIsHere.CodexMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexMonitor"
        Icon="Assets/CodexMonitor.ico"
        Width="460"
        Height="300"
        MinWidth="420"
        MinHeight="270"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontSize="22"
               FontWeight="SemiBold"
               Text="Codex 用量" />

    <Grid Grid.Row="2" Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="54" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock FontWeight="SemiBold" Text="5H" />
      <TextBlock Grid.Column="1" Text="{Binding FiveHourPercent}" />
      <TextBlock Grid.Column="2" Text="{Binding FiveHourCountdown}" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="54" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock FontWeight="SemiBold" Text="WK" />
      <TextBlock Grid.Column="1" Text="{Binding WeeklyPercent}" />
      <TextBlock Grid.Column="2" Text="{Binding WeeklyCountdown}" />
    </Grid>

    <Grid Grid.Row="4" Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="54" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock FontWeight="SemiBold" Text="REF" />
      <TextBlock Grid.Column="1" Text="{Binding LastRefreshText}" />
      <Ellipse Grid.Column="2"
               Width="10"
               Height="10"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Fill="{Binding StatusBrush}" />
      <TextBlock Grid.Column="3" Text="{Binding StatusText}" />
    </Grid>

    <TextBlock Grid.Row="6"
               Foreground="Firebrick"
               Text="{Binding ErrorText}"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="8" Orientation="Horizontal">
      <Button Width="100"
              Height="30"
              Command="{Binding RefreshCommand}"
              Content="立即刷新" />
      <TextBlock Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="Gray"
                 Text="{Binding RefreshIntervalText}" />
    </StackPanel>
  </Grid>
</Window>
