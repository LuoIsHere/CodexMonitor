<Window x:Class="LuoIsHere.CodexMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CodexMonitor"
        Icon="Assets/CodexMonitor.ico"
        Width="480"
        Height="170"
        MinWidth="440"
        MinHeight="160"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="{StaticResource PrimaryTextBrush}"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        CornerRadius="0"
                        GlassFrameThickness="-1"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="WindowSurface"
          Background="{StaticResource WindowTintBrush}"
          CornerRadius="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>

      <Border x:Name="TitleBarSurface"
              Grid.Row="0"
              Background="#12FFFFFF"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="0">
        <Grid Margin="10,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Image Width="16"
                 Height="16"
                 VerticalAlignment="Center"
                 Source="Assets/CodexMonitor.ico" />
          <TextBlock Grid.Column="1"
                     Margin="7,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Text="CodexMonitor" />

          <Button Grid.Column="2"
                  Command="{Binding RefreshCommand}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource TitleBarButtonStyle}"
                  ToolTip="立即刷新">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="15"
                       Text="&#xE72C;" />
          </Button>
          <Button Grid.Column="3"
                  Click="OnMinimizeClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource TitleBarButtonStyle}"
                  ToolTip="最小化">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       Text="&#xE921;" />
          </Button>
          <Button Grid.Column="4"
                  Click="OnCloseClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource TitleBarButtonStyle}"
                  ToolTip="关闭并隐藏到通知区域">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       Text="&#xE8BB;" />
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="16,7,16,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding FiveHourColumnWidth}" />
          <ColumnDefinition Width="{Binding FirstDividerWidth}" />
          <ColumnDefinition Width="{Binding WeeklyColumnWidth}" />
          <ColumnDefinition Width="{Binding SecondDividerWidth}" />
          <ColumnDefinition Width="{Binding ResetTimesColumnWidth}" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding FiveHourVisibility}"
                    VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Text="5H" />
          <TextBlock Margin="0,2,0,0"
                     HorizontalAlignment="Center"
                     FontSize="23"
                     FontWeight="SemiBold"
                     Text="{Binding FiveHourPercent}" />
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

        <StackPanel Grid.Column="2"
                    HorizontalAlignment="Center"
                    Visibility="{Binding WeeklyVisibility}"
                    VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Text="7D" />
          <TextBlock Margin="0,2,0,0"
                     HorizontalAlignment="Center"
                     FontSize="23"
                     FontWeight="SemiBold"
                     Text="{Binding WeeklyPercent}" />
        </StackPanel>

        <Border Grid.Column="3" Background="{StaticResource DividerBrush}" />

        <StackPanel Grid.Column="4"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ResetTimesVisibility}"
                    VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Text="RESET" />
          <StackPanel Margin="0,4,0,0"
                      HorizontalAlignment="Center"
                      Orientation="Horizontal">
            <TextBlock Width="24"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Text="5H" />
            <TextBlock FontSize="11"
                       Text="{Binding FiveHourResetTime}" />
          </StackPanel>
          <StackPanel Margin="0,3,0,0"
                      HorizontalAlignment="Center"
                      Orientation="Horizontal">
            <TextBlock Width="24"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Text="7D" />
            <TextBlock FontSize="11"
                       Text="{Binding WeeklyResetTime}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2"
              Margin="12,0"
              Background="{StaticResource SurfaceBrush}"
              CornerRadius="10">
        <Grid Margin="13,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"
                      Visibility="{Binding SubscriptionVisibility}"
                      Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Text="SUBSCRIPTION" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Text="{Binding AccountText}" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11"
                       Text="{Binding LastRefreshText}" />
            <Ellipse Width="6"
                     Height="6"
                     Margin="9,0,6,0"
                     VerticalAlignment="Center"
                     Fill="{Binding StatusBrush}" />
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="10"
                       Text="{Binding StatusText}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
